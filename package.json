{
  "name": "portabilidad-tareas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "check": "npm run lint && npm run format:check && npm run deps:check && npm run test"
  },
  "dependencies": { "express": "^5.3.0", "zod": "^4.6.7" },
  "devDependencies": { "eslint": "^10.14.0", "prettier": "^3.9.10", "dependency-cruiser": "^18.7.0", "vitest": "^5.0.5" }
}
